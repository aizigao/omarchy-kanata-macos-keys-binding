;; meta：按住物理 Alt（⌘ 位）；c/v 例外，其余键逐键带 Ctrl
(deflayer meta
  (tap-hold-press 200 200 esc rctl)
  lctl
  lalt
  esc
  ralt
  (multi lctl q)
  (multi lctl w)
  (multi lctl e)
  (multi lctl r)
  (multi lctl t)
  (multi lctl y)
  (multi lctl u)
  (multi lctl i)
  (multi lctl o)
  (multi lctl p)
  (multi lctl a)
  (multi lctl s)
  (multi lctl d)
  (multi lctl f)
  (multi lctl g)
  (multi lctl h)
  (multi lctl j)
  (multi lctl k)
  (multi lctl l)
  (multi lctl z)
  (multi lctl x)
  (switch ((input real lsft) (input real rsft)) (multi lctl c) break () (unmod (lctl) lmet c) break)
  (switch ((input real lmet) (input real rmet) (input real lsft) (input real rsft)) (multi lctl v) break () (unmod (lctl) lmet v) break)
  (multi lctl b)
  (multi lctl n)
  (multi lctl m)
  (multi lctl 1)
  (multi lctl 2)
  (multi lctl 3)
  (multi lctl 4)
  (multi lctl 5)
  (multi lctl 6)
  (multi lctl 7)
  (multi lctl 8)
  (multi lctl 9)
  (multi lctl 0)
  (multi lctl -)
  (multi lctl =)
  (multi lctl [)
  (multi lctl ])
  (multi lctl ;)
  (multi lctl ')
  (multi lctl ,)
  (multi lctl .)
  (multi lctl /)
  (multi lctl \)
  (multi lctl `)
  (multi lctl tab)
  (multi lctl ret)
  (multi lctl spc)
  (multi lctl bspc)
  (multi lctl del)
  (multi lctl up)
  (multi lctl down)
  (multi lctl left)
  (multi lctl right)
  (multi lctl home)
  (multi lctl end)
  (multi lctl pgup)
  (multi lctl pgdn)
  lmet
  rmet
  lsft
  rsft
)

;; meta-editor：同 meta，但 w 发 chord（Ctrl+W 然后 C）——只给 editor 层用
(deflayer meta-editor
  (tap-hold-press 200 200 esc rctl)
  lctl
